# KS Medical lead research tool - configuration template
# Copy this file to `.env` (same folder) and fill in what you need.
# Every setting is optional; the tool runs with no keys at all.
# NEVER commit your real .env file or share it.

# ---------------------------------------------------------------- identity
# Sent in the User-Agent so website owners can contact you about the crawler.
CONTACT_EMAIL=

# ------------------------------------------------------- politeness limits
REQUEST_DELAY_SECONDS=2          # minimum gap between requests to the same website
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=2                    # retries only for network errors / HTTP 5xx
MAX_RETRY_AFTER_SECONDS=120      # if a site asks us to wait longer than this, we stop for that site
RESPECT_ROBOTS_TXT=true          # keep this true

# ------------------------------------------------------------ crawl limits
MAX_PAGES_PER_COMPANY=15
MAX_PDFS_PER_COMPANY=3
MAX_THIRD_PARTY_PAGES_PER_COMPANY=4

# ------------------------------------------------------------ run control
BATCH_SIZE=10                    # workbook is re-saved after every batch
MAX_RUNTIME_MINUTES=180          # stops cleanly; re-run the same command to resume
CACHE_TTL_HOURS=168              # re-use downloaded pages for 7 days
RECHECK_AFTER_DAYS=30            # companies researched more recently are skipped on resume
WORK_DIR=ks_osint_work           # cache + progress files
DNS_CHECKS_ENABLED=true

# ------------------------------------------------- search API (optional)
# auto = first configured of brave, google_cse, serpapi. none = disable.
SEARCH_PROVIDER=auto
MAX_SEARCH_QUERIES_PER_COMPANY=8
MAX_TOTAL_SEARCH_QUERIES=300

# Brave Search API - https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
# Google Programmable Search JSON API - key + search engine ID (cx)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# SerpApi - https://serpapi.com/ (paid service with a small free allowance)
SERPAPI_API_KEY=

# ---------------------------------------------- official registries (free)
# UK Companies House: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ------------------------------------- paid / credit-consuming (optional)
# These are used ONLY when you run with --allow-paid AND type APPROVE at the prompt.
# A connection between Apollo and Claude (or any other app) does NOT give this script access.
HUNTER_API_KEY=
APOLLO_API_KEY=
MAX_PAID_CREDITS_PER_RUN=0       # hard cap per run; 0 disables paid lookups entirely
